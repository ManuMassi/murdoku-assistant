# File personali (foto/scansioni dei puzzle, PDF, archivi) — non fanno parte dell'app,
# che carica le immagini a runtime dal browser dell'utente, non da file nel repository.
*.jpg
*.jpeg
*.png
*.heic
*.heif
*.tif
*.tiff
*.webp
*.avif
*.dng
*.pdf
*.zip
# ...tranne le immagini della documentazione (lo screenshot del README)
!docs/*.png

# Pagine di prova usa-e-getta generate durante lo sviluppo (es. _detect_test.html,
# che estrae il blocco di rilevamento griglia da index.html e lo esegue su puzzle sintetici).
_*.html
